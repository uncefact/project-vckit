{
  "name": "@uncefact/vckit-did-provider-webvh",
  "description": "did:webvh (DID Web + Verifiable History) provider and resolver plugin for VCkit",
  "version": "1.0.0",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./build/plugin.schema.json": "./build/plugin.schema.json"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -b --watch",
    "extract-api": "node ../cli/bin/vckit.js dev extract-api",
    "test:conformance": "node conformance/run.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@uncefact/vckit-core-types": "workspace:^",
    "@veramo/core": "5.5.3",
    "@veramo/data-store": "5.5.3",
    "@veramo/did-manager": "5.5.3",
    "@veramo/utils": "5.5.3",
    "canonicalize": "2.0.0",
    "did-resolver": "^4.1.0",
    "didwebvh-ts": "2.8.0",
    "express": "^4.18.2",
    "typeorm": "^0.3.19"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@veramo/key-manager": "5.5.3",
    "@veramo/kms-local": "5.5.3",
    "js-yaml": "4.1.0",
    "sql.js": "1.10.3",
    "typescript": "5.1.6"
  },
  "peerDependencies": {
    "express": "^4.18.2"
  },
  "files": [
    "build/**/*",
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": "git@github.com:uncefact/project-vckit.git",
  "license": "Apache-2.0",
  "keywords": [
    "did:webvh",
    "verifiable-history",
    "decentralized-identity",
    "veramo",
    "vckit"
  ],
  "type": "module",
  "moduleDirectories": [
    "node_modules",
    "src"
  ]
}
